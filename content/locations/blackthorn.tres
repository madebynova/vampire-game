[sub_resource type="Resource" id="sp_key"]
script = ExtResource("3_sp")
secret_id = &"well_key"
position = Vector3(11, 0, 13.9)
sense_label = "Buried: cellar key"
prompt = "Dig up the buried key"
reveal_text = "Blood memory: something is buried beneath the well. Vampiric Sense will show where."
found_text = "You dig up a rusted iron key. It belongs to the cellar hatch inside the house."
grants_flag = &"cellar_key"

[sub_resource type="Resource" id="sp_ledger"]
script = ExtResource("3_sp")
secret_id = &"cottage_ledger"
position = Vector3(18.6, 0, 16.6)
sense_label = "Hidden: a book of names"
prompt = "Pry up the loose board"
reveal_text = "Dream memory: a ledger is hidden under a loose board in Tomas' cottage."
found_text = "A leather ledger. Column after column of names in a hand that isn't Tomas'. The last line is unfinished: 'E. Marr'."
grants_flag = &"ledger_read"

[resource]
