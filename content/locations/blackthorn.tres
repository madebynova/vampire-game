[sub_resource type="Resource" id="in_watch_log"]
script = ExtResource("6_ip")
id = &"watch_log"
position = Vector3(9.6, 0.92, 23.9)
prompt = "Read the watch log"
text = "The night watchman's log, in a careful hand: 'All quiet.' 'All quiet.' 'All quiet.' 'All quiet.' A fifth line has been begun and scratched out so hard that the page is torn."
mark_size = Vector2(0.32, 0.24)
mark_color = Color(0.9, 0.86, 0.72, 1)

[sub_resource type="Resource" id="in_north_wax"]
script = ExtResource("6_ip")
id = &"north_wax"
position = Vector3(1.0, 0.14, -16.9)
prompt = "Examine the ground under the north window"
text = "Candle wax, still soft, spattered on the grass beneath the broken north window, and a smear of lavender oil on the sill above. Whoever stood here stood a long while. The drips lead toward the pines."
mark_size = Vector2(0.7, 0.5)
mark_color = Color(0.92, 0.86, 0.66, 1)

[sub_resource type="Resource" id="in_gate_lock"]
script = ExtResource("6_ip")
id = &"gate_lock"
position = Vector3(3.0, 1.1, 29.2)
prompt = "Examine the gate lock"
text = "The lock plate on this side is smooth and untouched. Through the bars you can see the outer plate: the keyhole is scored with fresh scratches, as if someone has been trying to get IN, not out."

