[gd_resource type="Resource" script_class="SunlightProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/sunlight_profile.gd" id="1_prof"]

[resource]
script = ExtResource("1_prof")
id = &"default"
display_name = "Default sunlight"
description = "About three minutes of continuous full sunlight to die."
stage_names = PackedStringArray("Safe", "Initial", "Prolonged", "Severe", "Critical")
stage_from_heat = PackedFloat32Array(0, 0, 8, 80, 140)
stage_dps = PackedFloat32Array(0, 0, 0.2, 0.55, 1.3)
stage_speed = PackedFloat32Array(1, 1, 0.97, 0.85, 0.65)
heat_max = 240.0
cooldown_per_sec = 0.5
shade_threshold = 0.03
