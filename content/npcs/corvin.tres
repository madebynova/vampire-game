[resource]
script = ExtResource("1_prof")
id = &"corvin"
display_name = "Corvin Hale"
occupation = "Night watchman"
skin_color = Color(0.72, 0.56, 0.46, 1)
cloth_color = Color(0.16, 0.2, 0.3, 1)
pants_color = Color(0.14, 0.14, 0.17, 1)
hair_color = Color(0.1, 0.09, 0.09, 1)
base_heart_rate = 74.0
notice_radius = 11.0
night_notice_bonus = 6.0
light_sleeper = 1.2
can_follow = false
greeting_lines = PackedStringArray("Lamps are lit, so mind the road. I walk it till dawn.", "Not a night for strangers. Keep to the light, friend.")
familiar_lines = PackedStringArray("You again. I sleep by the gate in the daytime, and the less that is said about that the better.")
trust_lines = PackedStringArray()
night_lines = PackedStringArray("Halt. Who walks? ...Ah. Forgive me. The dark has me jumping at lamp-posts.", "Nine lamps. Count them with me, if you can't sleep. It helps.")
tidings = Array[ExtResource("4_tid")]([SubResource("td_gate"), SubResource("td_roof"), SubResource("td_elise"), SubResource("td_tenth")])
blood_type = &"iron"
blood_description = "Cold iron and lamp-smoke. Vigilance has a taste."
blood_yield = 40.0
memories = Array[ExtResource("2_mem")]([SubResource("mem_calm"), SubResource("mem_asleep"), SubResource("mem_afraid"), SubResource("mem_trusting"), SubResource("mem_deep")])
schedule = Array[ExtResource("3_sch")]([SubResource("sch_sleep"), SubResource("sch_idle"), SubResource("sch_patrol")])
