[resource]
script = ExtResource("1_prof")
id = &"tomas"
display_name = "Tomas Reeve"
occupation = "Groundskeeper"
skin_color = Color(0.8, 0.62, 0.5, 1)
cloth_color = Color(0.3, 0.38, 0.24, 1)
pants_color = Color(0.3, 0.24, 0.18, 1)
hair_color = Color(0.55, 0.55, 0.55, 1)
base_heart_rate = 66.0
notice_radius = 10.0
night_notice_bonus = 0.0
light_sleeper = 0.6
can_follow = true
greeting_lines = PackedStringArray("Evening, stranger. Mind the road - it's a long way to anywhere.", "The Blackthorn house? Shuttered for years. Best leave it be.", "Folk say the old place isn't empty. I keep the grounds. I don't go inside.")
familiar_lines = PackedStringArray("You again. I turn in when the lamps are lit - the cottage past the graves. Early to bed, early to rise.", "Nobody bothers me at night. Sleep like a stone, I do. Wife used to say the house could burn down around me.")
trust_lines = PackedStringArray("You've an honest face. Come, I'll show you where the shade is good.", "Lead on, then. I'll walk with you a spell.")
night_lines = PackedStringArray("Lamp's lit, so I'm awake. Just barely. Don't stay out in the damp.")
tidings = Array[ExtResource("4_tid")]([SubResource("td_foxes"), SubResource("td_corvin"), SubResource("td_elise"), SubResource("td_names")])
blood_type = &"aged"
blood_description = "Aged and smoky. Pipe tobacco, cold rain, old habit."
blood_yield = 45.0
memories = Array[ExtResource("2_mem")]([SubResource("mem_calm"), SubResource("mem_asleep"), SubResource("mem_afraid"), SubResource("mem_trusting"), SubResource("mem_deep")])
schedule = Array[ExtResource("3_sch")]([SubResource("sch_work"), SubResource("sch_evening"), SubResource("sch_sleep")])
