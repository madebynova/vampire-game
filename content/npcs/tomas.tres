[gd_resource type="Resource" script_class="NpcProfile" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/npc_profile.gd" id="1_prof"]
[ext_resource type="Script" path="res://scripts/data/blood_memory.gd" id="2_mem"]
[ext_resource type="Script" path="res://scripts/data/schedule_entry.gd" id="3_sch"]

[sub_resource type="Resource" id="mem_calm"]
script = ExtResource("2_mem")
condition = &"calm"
title = "The Well, Before Dawn"
text = "Rain on shoulders that are not yours. A heavy iron key, cold in a shaking hand. You kneel by the well and bury it beneath the flagstone.\n\n'Not even the Lord's guests should find the cellar.'"
facts = PackedStringArray("Tomas Reeve keeps the Blackthorn grounds.", "He is afraid of something beneath the house.", "He buried the cellar key under the well.")
reveals_secret = &"well_key"

[sub_resource type="Resource" id="mem_asleep"]
script = ExtResource("2_mem")
condition = &"asleep"
title = "A Dream of Ink"
text = "Sleep-slow blood. A lamp, a quill, a column of names in a cramped hand. Beneath a loose board by the bed a leather book waits, and in the dream you are writing in it, though you never learned to write.\n\nThe last name is not yet finished. It begins with an E."
facts = PackedStringArray("Tomas keeps a ledger of names.", "He hides it beneath a loose board in his cottage.", "He does not remember writing it.")
reveals_secret = &"cottage_ledger"

[sub_resource type="Resource" id="mem_afraid"]
script = ExtResource("2_mem")
condition = &"afraid"
title = "Nine Sets of Footsteps"
text = "Terror has no plot, only fragments: boots on flagstone, a lantern swinging, a hood turned toward the window. You count them again and again. Not seven. Nine.\n\nSomeone was counting on Tomas to say seven."
facts = PackedStringArray("Tomas counted nine figures, not seven.", "Someone wanted a smaller number remembered.")

